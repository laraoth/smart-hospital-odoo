<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_form_inherited" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherited</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="medical_license_number" string="Medical License Number"/>
                <field name="license_expiry_date" string="License Expiry Date"/>
            </xpath>
        </field>
    </record>
</odoo>
